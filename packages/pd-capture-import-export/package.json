{
  "name": "@usb-pd-sniffer/pd-capture-import-export",
  "version": "0.1.0",
  "description": "Browser-side capture file import/export helpers for USB PD sniffer records.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist *.tsbuildinfo && pnpm exec tsc -p tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "pnpm exec tsc -p tsconfig.json --pretty false"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "@usb-pd-sniffer/pd-core": "workspace:*",
    "@usb-pd-sniffer/pd-device-atk-c2": "workspace:*",
    "@usb-pd-sniffer/pd-device-types": "workspace:*",
    "fflate": "^0.8.3",
    "papaparse": "^5.5.3"
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
