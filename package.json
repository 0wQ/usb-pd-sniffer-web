{
  "name": "usb-pd-sniffer-web-v2-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.29.2"
  },
  "scripts": {
    "web:dev": "pnpm -C packages/pd-web dev",
    "web:build": "pnpm -C packages/pd-web build",
    "web:preview": "pnpm -C packages/pd-web preview",
    "lint": "biome lint packages",
    "format": "biome format --write packages",
    "check": "biome check packages",
    "build": "pnpm run clean && pnpm exec tsc -b tsconfig.json",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo",
    "test": "pnpm exec vitest run",
    "typecheck": "pnpm exec tsc -b tsconfig.json --pretty false && pnpm -C packages/pd-core run typecheck:tests"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/node": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "pnpm": {
    "overrides": {
      "vite": "npm:rolldown-vite@7.1.14"
    }
  }
}
